# ============================================
# 데이터베이스
# ============================================
# 로컬 개발
DATABASE_URL="postgresql://postgres:password@localhost:5432/startpackage?schema=public"
# 프로덕션 (Neon)
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/startpackage?sslmode=require"

# ============================================
# NCP SENS SMS 발송
# ============================================
NCP_SERVICE_ID="ncp:sms:kr:xxxxxxx:xxxx"
NCP_ACCESS_KEY="ncp_iam_XXXXXXXXXXXXX"
NCP_SECRET_KEY="ncp_iam_XXXXXXXXXXXXX"
NCP_SENDER_PHONE="01012345678"  # 발신 번호 (NCP에 등록된 번호)

# ============================================
# 이메일 발송 (Resend)
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="noreply@polaai.co.kr"

# ============================================
# NextAuth
# ============================================
# 로컬 개발
NEXTAUTH_URL="http://localhost:3005"
# 프로덕션
# NEXTAUTH_URL="https://polaai.co.kr"

# 강력한 시크릿 생성: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-change-this"

# ============================================
# 슬랙 알림 (관리자)
# ============================================
SLACK_BOT_TOKEN="xoxb-xxxxxxxxxxxxx"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# ============================================
# 텔레그램 봇 (관리자 알림)
# ============================================
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# ============================================
# 애플리케이션 URL
# ============================================
# 로컬 개발
NODE_ENV="development"
APP_URL="http://localhost:3005"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# 프로덕션
# NODE_ENV="production"
# APP_URL="https://polaai.co.kr"
# NEXT_PUBLIC_APP_URL="https://polaai.co.kr"

# ============================================
# Sentry 에러 모니터링 (선택사항)
# ============================================
# Sentry 프로젝트 DSN (Data Source Name)
# https://sentry.io/ 에서 프로젝트 생성 후 DSN 복사
# SENTRY_DSN="https://xxxxxxxxxxxxx@o123456.ingest.sentry.io/123456"
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxxxxxxx@o123456.ingest.sentry.io/123456"

# Sentry 인증 토큰 (Source Maps 업로드용, 프로덕션 빌드만)
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxx"

# Sentry 조직/프로젝트 정보
# SENTRY_ORG="your-organization"
# SENTRY_PROJECT="your-project"
