# ===========================================
# 스타트패키지 환경변수 템플릿
# ===========================================
# 이 파일을 .env.local로 복사하여 실제 값을 입력하세요.
# .env.local은 Git에 커밋되지 않습니다.

# ===========================================
# 기존 환경변수 (예시)
# ===========================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/startpackage"

# NextAuth
NEXTAUTH_URL="http://localhost:3005"
NEXTAUTH_SECRET="your-nextauth-secret"

# UploadThing
UPLOADTHING_TOKEN="your-uploadthing-token"

# ===========================================
# Google Drive API (Service Account)
# ===========================================
# 설정 가이드: docs/google-drive-api-setup-guide.html

# 서비스 계정 이메일 (JSON 파일의 client_email 값)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# 서비스 계정 비공개 키 (JSON 파일의 private_key 값)
# 주의: 따옴표 안에 \n 포함된 상태로 그대로 붙여넣기
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Google Drive 루트 폴더 ID
# 폴더 URL에서 확인: https://drive.google.com/drive/folders/[이 부분이 폴더 ID]
GOOGLE_DRIVE_ROOT_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"
