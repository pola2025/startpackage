# ============================================
# 프로덕션 환경 변수 템플릿
# ============================================
# 이 파일을 참고하여 Vercel에 환경 변수를 등록하세요
# ⚠️ 이 파일은 Git에 커밋하지 마세요!

# ============================================
# 데이터베이스 (Neon PostgreSQL)
# ============================================
DATABASE_URL="postgresql://[USERNAME]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require"
# 예시: postgresql://user:password@ep-abc123.neon.tech/startpackage?sslmode=require
# Neon Console → Connection Details에서 복사

# ============================================
# NextAuth
# ============================================
NEXTAUTH_URL="https://polaai.co.kr"
NEXTAUTH_SECRET="[openssl rand -base64 32로 생성한 시크릿]"
# 시크릿 생성: PowerShell에서 아래 명령 실행
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))

# ============================================
# 애플리케이션 URL
# ============================================
NEXT_PUBLIC_APP_URL="https://polaai.co.kr"

# ============================================
# NCP SENS (SMS 발송)
# ============================================
NCP_SERVICE_ID="ncp:sms:kr:xxxxxxx:xxxx"
NCP_ACCESS_KEY="ncp_iam_XXXXXXXXXXXXX"
NCP_SECRET_KEY="ncp_iam_XXXXXXXXXXXXX"
NCP_SENDER_PHONE="01012345678"

# ============================================
# Resend (이메일 발송)
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="noreply@polaai.co.kr"

# ============================================
# Slack 알림 (선택사항)
# ============================================
SLACK_BOT_TOKEN="xoxb-xxxxxxxxxxxxx"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# ============================================
# Telegram 봇 알림 (선택사항)
# ============================================
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# ============================================
# 참고사항
# ============================================
# 1. DATABASE_URL: Neon Console에서 복사
# 2. NEXTAUTH_SECRET: 랜덤 문자열 생성 필요
# 3. NCP_*: NCP Console → SENS 서비스에서 확인
# 4. RESEND_API_KEY: Resend Dashboard에서 발급
# 5. Slack/Telegram: 선택사항 (설정하지 않아도 동작함)
