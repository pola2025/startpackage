// 스타트패키지 데이터베이스 스키마
// Next.js + Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. 기수 관리
// ============================================

model Cohort {
  id   String @id @default(cuid())
  name String // "1기", "2기", "19기"
  englishName String? // 영문명 (슬랙 채널명 등에 사용, 예: "1st", "2nd", "19th")

  // 교육 일정
  교육시작일        DateTime
  교육요일          String   // "월", "화", "수", "목", "금"
  자료제출마감일    DateTime

  // 상태
  isActive Boolean @default(true)

  // 관계
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([자료제출마감일])
  @@map("cohorts")
}

// ============================================
// 2. 사용자
// ============================================

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String // bcrypt 해시

  // 기본 정보
  이름 String
  englishName String? // 영문 이름 (슬랙 채널명 등에 사용)
  연락처 String

  // 기수
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  // 알림 수신 동의
  SMS수신동의    Boolean @default(false)
  이메일수신동의 Boolean @default(false)

  // 공지사항 이메일 수신 설정
  공지사항이메일수신 Boolean @default(true)

  // 콘텐츠 제작 Tip 이메일 수신 설정
  콘텐츠팁이메일수신 Boolean @default(false)

  // 역할
  role String @default("user") // "user" | "admin"

  // 수료생 상태
  status UserStatus @default(active) // "active" (현재 수강생) | "graduated" (수료생) | "inactive" (비활성)
  graduatedAt DateTime? // 수료일 (수료생인 경우)

  // 알림 채널 ID
  slackChannelId   String? // 슬랙 채널 ID (기수명_이름_브랜드명)
  telegramChatId   String? // 텔레그램 채팅 ID

  // 마케팅 지원 기간 (기수 정책 기준: 26-5기부터 8주, 이전 기수 3개월)
  marketingSupportEnabled   Boolean   @default(false) // 활성화 여부
  marketingSupportStartDate DateTime? // 시작일
  marketingSupportEndDate   DateTime? // 종료일

  // 광고자동화 (시점 관리)
  adAutomationEnabled   Boolean   @default(false) // 광고자동화 활성화 여부
  adAutomationStartDate DateTime? // 광고자동화 시작일
  adAutomationEndDate   DateTime? // 광고자동화 종료일

  // SMS 설정 (시점 관리)
  smsSettingEnabled   Boolean   @default(false) // SMS 설정 완료 여부
  smsSettingStartDate DateTime? // SMS 설정 완료일
  smsSettingEndDate   DateTime? // SMS 설정 종료일

  // 네이버 키워드 광고 설정 (시점 관리)
  naverAdSettingEnabled   Boolean   @default(false) // 네이버 광고 설정 완료 여부
  naverAdSettingStartDate DateTime? // 네이버 광고 설정 완료일
  naverAdSettingEndDate   DateTime? // 네이버 광고 설정 종료일

  // 홈페이지 설정 (완료/미완료)
  homepageCompleted   Boolean   @default(false) // 홈페이지 완료 여부
  homepageCompletedAt DateTime? // 홈페이지 완료일 (완료 버튼 누른 시점)

  // 관계
  submission                Submission?
  workflows                 Workflow[]
  notifications             Notification[]
  marketingExtensionRequests MarketingExtensionRequest[]
  communicationThreads      CommunicationThread[]
  modalDismissals           ModalDismissal[]
  alertDismissals           AlertDismissal[]
  adAutomationHistory       AdAutomationHistory[]
  adAutomationPayments      AdAutomationPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cohortId])
  @@index([email])
  @@index([status])
  @@map("users")
}

// ============================================
// 3. 자료 제출
// ============================================

model Submission {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // === 필수 제출 항목 ===

  // 인쇄물
  사업자등록증URL String?
  프로필사진URL   String?

  // 브랜드 정보
  브랜드명 String?
  brandNameEnglish String? // 브랜드 영문명 (슬랙 채널명 등에 사용)
  업종     String?
  주소     String?

  // 마케팅
  메타광고관리자값 String?
  네이버검색광고ID String?
  네이버검색광고PW String?
  네이버클라우드ID String?
  네이버클라우드PW String?
  InstagramID     String?
  InstagramPW     String?
  GmailID         String? // Gmail 계정 ID (메일발신용)
  GmailPW         String? // Gmail 계정 비밀번호

  // 홈페이지
  홈페이지스타일   String? // "기본스타일" | URL (템플릿 링크)
  홈페이지컬러컨셉 String? // 16진수 색상값

  // 홈페이지 제작 방식
  홈페이지제작방식 String? // "외부서비스" (과거 "아임웹" 데이터 존재, 신규는 "외부서비스"만)

  // [deprecated] 아임웹 제작 방식은 2026-04 이후 지원 종료.
  // 기존 데이터 보존을 위해 컬럼만 유지 (신규 입력 차단)
  아임웹ID         String?
  아임웹PW         String?
  아임웹관리자PW   String?

  // 외부 서비스 제작 시 필요 정보
  도메인주소           String? // 실제 도메인 주소 (예: www.mybrand.co.kr)
  도메인관리사이트     String? // "가비아" | "후이즈" | "카페24" | "닷홈" 등
  도메인관리ID         String?
  도메인관리PW         String?
  해외결제카드앞면URL  String? // 카드 이미지 (카드번호 보이도록)
  해외결제카드뒷면URL  String? // 카드 뒷면 이미지 (레거시, 더 이상 사용 안 함)
  해외결제카드유효기간 String? // MM/YY 형식
  해외결제카드CVC     String? // CVC 번호 (3자리)

  // === 추가 정보 ===

  대표번호 String?
  이메일   String? // 명함에 들어갈 이메일 (user.email과 다를 수 있음)

  // 로고
  로고URL      String?
  로고선호스타일 String?
  로고선호색상   String?
  로고선호폰트   String?
  로고제작요청사항 String? @db.Text // 상세 제작 요청사항 (필수)

  // 명함
  명함색상 String?
  명함시안 String?

  // 계약서
  계약서시안 String?

  // 계좌 정보
  은행명         String?
  계좌번호       String?
  계좌명의자명   String? // 사업자 대표와 다를 경우 입력 (비어있으면 사업자대표명 = 명의자)

  // SMS 발신 등록용 서류
  대표자생년월일          String?
  대표자신분증URL        String?
  통신서비스이용증명원URL String?
  신용카드앞면URL        String?
  로고예시디자인URL      String?
  로고예시디자인2URL     String?

  // 배송 정보
  인쇄물받을주소 String?

  // === 제출 상태 ===
  isComplete  Boolean   @default(false)
  completedAt DateTime?
  시안예정일   DateTime? // 시안 전달 예정일 (평일 기준 3일)

  // 진행 상태 추적
  submissionStatus String @default("작성중") // "작성중" | "검토중" | "보완필요" | "완료"
  progressPercentage Int @default(0) // 0-100

  // 자동저장 메타데이터
  lastAutoSaveAt DateTime?
  autoSaveData   Json? // 임시 저장 데이터

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("submissions")
}

// ============================================
// 4. 워크플로우 (인쇄물별 진행 상태)
// ============================================

model Workflow {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 인쇄물 종류
  type String // "명함", "명찰", "대봉투", "자문계약서"

  // 상태
  status String @default("대기") // "대기" | "시안중" | "발주대기" | "발주요청" | "발주완료" | "제작완료" | "발송완료"

  // === 📅 날짜 추적 ===
  자료제출일   DateTime?
  시안업로드일 DateTime?
  발주요청일   DateTime?
  발주승인일   DateTime?
  예상발주일   DateTime?
  예상도착일   String? // "YYYY-MM-DD" 또는 "YYYY-MM-DD ~ YYYY-MM-DD" 형식
  제작완료일   DateTime?
  발송일       DateTime?

  // === 파일 ===
  시안URL String?

  // === 📦 택배 정보 (인쇄물별로 다름) ===
  택배회사   String?
  운송장번호 String?

  // === 수정 이력 ===
  수정횟수 Int @default(0) // 시안 수정 요청 횟수 (정책: 최대 2회)

  // === 다운로드 이력 ===
  다운로드횟수 Int @default(0) // 시안/결과물 파일 다운로드 횟수 (정책: 최대 100회, 인쇄 리소스 보호)

  시안이력 Json? // [{ version: 1, url: "...", uploadedAt: "2024-01-01T00:00:00Z", uploadedBy: "admin" }]

  // === 피드백 ===
  feedback     String? @db.Text // 사용자 피드백 (수정 요청사항)
  feedbackDate DateTime? // 피드백 작성 시간
  feedbackRead Boolean @default(false) // 관리자 피드백 확인 여부

  // === 임시저장 관련 ===
  isDraft Boolean @default(true) // true: 임시저장, false: 최종저장
  draftSavedAt DateTime? // 임시저장 시각

  // 관계
  logs WorkflowLog[]
  designHistory DesignHistory[]
  modalDismissals ModalDismissal[]
  designThread DesignThread? // 시안 쓰레드 (시안관리 페이지용)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("workflows")
}

// ============================================
// 4-1. 시안 쓰레드 (시안관리 페이지용)
// ============================================

model DesignThread {
  id         String   @id @default(cuid())
  workflowId String   @unique
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // 상태: pending(대기) | uploaded(시안업로드됨) | feedback_waiting(피드백대기) | revision_requested(수정요청) | confirmed(확정완료)
  status String @default("pending")

  // 현재 시안 버전
  currentVersion Int @default(0)

  // 최종 확정
  confirmedAt     DateTime?
  confirmedByName String?

  // 최종 확정 파일 (R2) - 레거시, finalFiles 사용 권장
  finalFileUrl       String?   // R2 다운로드 URL (단일 파일용, deprecated)
  finalFileName      String?   // 파일명 (deprecated)
  finalFileUploadedAt DateTime?

  // 메시지 관계
  messages DesignThreadMessage[]

  // 최종 확정 파일들 (다중 파일 지원)
  finalFiles DesignFinalFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("design_threads")
}

// ============================================
// 4-1-1. 시안 최종 확정 파일 (다중 파일)
// ============================================

model DesignFinalFile {
  id       String       @id @default(cuid())
  threadId String
  thread   DesignThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // 파일 정보
  fileName    String   // 원본 파일명 (예: "명함_최종.ai")
  fileType    String   // 파일 타입 (ai, psd, png, jpg, pdf 등)
  fileSize    Int?     // 파일 크기 (bytes)
  fileUrl     String   // R2 URL

  // 업로드 정보
  uploadedBy   String?  // 업로드한 관리자 ID
  uploadedAt   DateTime @default(now())

  @@index([threadId])
  @@map("design_final_files")
}

// ============================================
// 4-2. 시안 쓰레드 메시지
// ============================================

model DesignThreadMessage {
  id       String       @id @default(cuid())
  threadId String
  thread   DesignThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // 작성자
  authorId   String
  authorType String  // "admin" | "user"
  authorName String

  // 메시지 유형: design_upload(시안업로드) | revision_request(수정요청) | message(일반메시지) | confirmation(확정)
  messageType String

  // 내용
  content     String   @db.Text
  attachments String[] // 첨부파일 URL 배열 (R2)

  // 시안 업로드인 경우
  designVersion Int?     // 시안 버전 (1차, 2차...)
  designUrl     String?  // 시안 파일 URL (R2)

  // 읽음 상태
  isReadByAdmin Boolean @default(false)
  isReadByUser  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([createdAt])
  @@map("design_thread_messages")
}

// ============================================
// 5. 워크플로우 변경 로그
// ============================================

model WorkflowLog {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // 작업 내용
  action String // "시안업로드" | "발주승인" | "택배발송" | "상태변경"

  // 누가 작업했는지
  performedBy     String? // User ID 또는 Admin ID
  performedByName String? // 이름

  // 상태 변경
  previousStatus String?
  newStatus      String

  // 추가 정보 (JSON)
  metadata Json? // { fileName: "명함_시안.pdf", 택배회사: "CJ대한통운" }

  createdAt DateTime @default(now())

  @@index([workflowId])
  @@index([createdAt])
  @@map("workflow_logs")
}

// ============================================
// 5-1. 시안 업로드 이력
// ============================================

model DesignHistory {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  version    Int      // 1차시안, 2차시안, 3차시안...
  fileUrl    String   // 파일 경로
  uploadedBy String   // 업로드한 관리자 ID
  uploadedByName String // 업로드한 관리자 이름

  createdAt DateTime @default(now())

  @@index([workflowId])
  @@index([createdAt])
  @@map("design_history")
}

// ============================================
// 6. 알림 (SMS/이메일)
// ============================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 알림 정보
  type    String      // "회원가입완료" | "2주차미제출알림" | "마감7일전" | "마감3일전" | "마감1일전" | "시안완료" | "발주완료" | "제작완료" | "발송완료" | "수동발송"
  channel String      // "SMS" | "EMAIL"
  title   String
  message String      @db.Text

  // 발송 결과
  status       String  @default("전송중") // "전송중" | "성공" | "실패"
  errorMessage String? @db.Text

  // 수동 발송 시
  sentBy       String? // Admin ID
  sentByName   String?

  // 메타데이터
  metadata Json? // 추가 정보

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([sentAt])
  @@map("notifications")
}

// ============================================
// 7. 관리자
// ============================================

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String // bcrypt 해시 (레거시, 2FA 전환 후 미사용)
  name     String

  // 권한
  role String @default("operator") // "super" | "designer" | "operator"

  // 2FA (Google Authenticator TOTP)
  twoFactorSecret    String?         // TOTP 시크릿 (Base32)
  twoFactorEnabled   Boolean @default(false) // 2FA 활성화 여부
  twoFactorSetupToken String? @unique // 일회용 셋업 토큰

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ============================================
// 8. 관리자 가입 신청
// ============================================

model AdminRequest {
  id       String @id @default(cuid())
  email    String @unique
  password String // bcrypt 해시 (승인 시 Admin 테이블로 이동)
  name     String
  phone    String // 전화번호

  // 신청 상태
  status String @default("pending") // "pending" | "approved" | "rejected"

  // 승인/거부 정보
  reviewedBy   String? // 승인/거부한 관리자 ID
  reviewedAt   DateTime?
  rejectReason String? // 거부 사유

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@map("admin_requests")
}

// ============================================
// 8. 시스템 설정
// ============================================

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String  @db.Text
  description String?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// 예시 설정값:
// { key: "수정최대횟수", value: "2" }
// { key: "추가수정비용", value: "10000" }
// { key: "택배회사목록", value: '["CJ대한통운", "우체국택배", "한진택배", "로젠택배"]' }

// ============================================
// 9. 마케팅 지원 연장 신청
// ============================================

model MarketingExtensionRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 신청 정보
  requestDate    DateTime @default(now()) // 신청일
  currentEndDate DateTime // 현재 종료일
  newEndDate     DateTime // 새로운 종료일 (현재 종료일 + 3개월)
  requestMessage String?  @db.Text // 요청 메시지

  // 신청 상태
  status String @default("pending") // "pending" | "approved" | "rejected"

  // 승인/거부 정보
  reviewedBy     String? // 승인/거부한 관리자 ID
  reviewedAt     DateTime? // 승인/거부 시간
  adminResponse  String?  @db.Text // 관리자 응답 메시지

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([requestDate])
  @@map("marketing_extension_requests")
}

// ============================================
// 커뮤니케이션 (1:N 대화형)
// ============================================

// 커뮤니케이션 스레드 (요청)
model CommunicationThread {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 요청 정보
  title      String // 제목
  category   String @default("일반") // "홈페이지" | "로고" | "인쇄물" | "일반"
  status     String @default("open") // "open" | "in_progress" | "resolved"

  // 완료 예상 일정
  expectedCompletionDate DateTime?

  // 정렬용 (최신 답글 시간)
  lastReplyAt DateTime @default(now())

  // 관계
  messages CommunicationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([lastReplyAt])
  @@map("communication_threads")
}

// 커뮤니케이션 메시지 (답글)
model CommunicationMessage {
  id       String              @id @default(cuid())
  threadId String
  thread   CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // 작성자 정보
  authorId   String // User ID 또는 Admin ID
  authorType String // "user" | "admin"
  authorName String // 작성자 이름

  // 내용
  content     String   @db.Text
  attachments String[] // 첨부파일 URL 배열

  // 완료 예상일 (관리자 답변 시)
  expectedCompletionDate DateTime?

  // 읽음 상태 (사용자가 관리자 메시지를 읽었는지)
  isReadByUser Boolean @default(false)
  readByUserAt DateTime? // 사용자가 읽은 시간

  // 관리자 읽음 상태 (관리자가 사용자 메시지를 읽었는지)
  isReadByAdmin Boolean @default(false)
  readByAdminAt DateTime? // 관리자가 읽은 시간

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([createdAt])
  @@map("communication_messages")
}

// ============================================
// 공지사항 / 마케팅 소식
// ============================================

model Announcement {
  id String @id @default(cuid())

  // 작성자 (관리자)
  authorId   String
  authorName String

  // 내용
  title   String
  content String @db.Text

  // 미디어
  imageUrls  String[] @default([]) // 게시글 이미지 (여러 개)
  youtubeUrl String? // 유튜브 영상 링크

  // 발행 상태
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
  @@map("announcements")
}

// ============================================
// 콘텐츠 제작 Tip
// ============================================

model ContentTip {
  id String @id @default(cuid())

  // 작성자 (관리자)
  authorId   String
  authorName String

  // 내용
  title       String // 제목
  description String @db.Text // 간략한 설명

  // 링크
  linkType String // "youtube" | "blog"
  linkUrl  String // 유튜브 또는 블로그 링크

  // 썸네일 (선택)
  thumbnailUrl String? // 썸네일 이미지

  // 카테고리 시스템
  category    String  // "instagram" | "meta_ads" | "naver_blog" | "ai"
  subCategory String? // 관리자가 직접 입력하는 서브카테고리 (예: "릴스", "카드뉴스", "광고 소재")

  // 발행 상태
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category]) // 카테고리별 조회 최적화
  @@index([createdAt])
  @@map("content_tips")
}

// ============================================
// Enums
// ============================================

// 사용자 상태
enum UserStatus {
  active    // 현재 수강생 (워크플로우, 자료 제출 등 모든 기능 사용 가능)
  graduated // 수료생 (커뮤니케이션, 마케팅 소식만 접근 가능)
  inactive  // 비활성 (탈퇴, 휴학 등)
}

// ============================================
// 시안 확인 모달 숨김 기록
// ============================================

model ModalDismissal {
  id         String   @id @default(cuid())

  // 사용자
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 워크플로우
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // 숨김 정보
  dismissedAt DateTime @default(now())  // 숨김 시각
  expiresAt   DateTime                  // 만료 시각 (dismissedAt + 24시간)

  createdAt DateTime @default(now())

  @@unique([userId, workflowId])
  @@index([userId, expiresAt])
  @@map("modal_dismissals")
}

// ============================================
// 필수 필드 설정
// ============================================

model RequiredFieldConfig {
  id           String   @id @default(cuid())

  // 워크플로우 타입
  workflowType String   // "로고", "명함", "리플렛" 등

  // 필수 필드
  fieldName    String   // "브랜드명", "이름" 등
  fieldLabel   String   // "브랜드명 (한글)"
  fieldReason  String   // "로고에 표시될 브랜드명"
  fieldOrder   Int      // 표시 순서

  // 검증 규칙
  validationType String @default("notEmpty") // "notEmpty", "email", "phone" 등
  minLength      Int?
  maxLength      Int?

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workflowType, fieldName])
  @@index([workflowType, isActive])
  @@map("required_field_configs")
}

// ============================================
// 시스템 알림 (관리자가 등록하는 범용 모달 알림)
// ============================================

model SystemAlert {
  id      String @id @default(cuid())

  // 알림 내용
  title   String       // 알림 제목
  content String @db.Text // 알림 내용 (마크다운 지원 가능)

  // 알림 유형
  type     String       // "info" | "warning" | "urgent"
  priority Int          // 우선순위 (높을수록 먼저 표시)

  // 표시 기간
  startDate DateTime     // 표시 시작일
  endDate   DateTime     // 표시 종료일

  // 상태
  isActive Boolean @default(true) // 활성화 여부

  // 기수 타겟팅 (null = 전체, 값 있으면 해당 기수만)
  cohortId    String?  // Cohort.id 참조 (외래키 없이 단순 필터)
  phoneNumber String?  // 연락처 표시 (선택)

  // 작성자
  createdBy     String  // 작성한 관리자 ID
  createdByName String  // 작성한 관리자 이름

  // 관계
  dismissals AlertDismissal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startDate, endDate])
  @@index([priority])
  @@map("system_alerts")
}

// ============================================
// 알림 숨김 기록 (24시간)
// ============================================

model AlertDismissal {
  id      String @id @default(cuid())

  // 사용자
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 알림
  alertId String
  alert   SystemAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  // 숨김 정보
  dismissedAt DateTime @default(now()) // 숨김 시각
  expiresAt   DateTime                 // 만료 시각 (dismissedAt + 24시간)

  createdAt DateTime @default(now())

  @@unique([userId, alertId])
  @@index([userId, expiresAt])
  @@map("alert_dismissals")
}

// ============================================
// 광고자동화 이력
// ============================================

model AdAutomationHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 이력 정보
  action      String   // "enabled" | "disabled"
  actionBy    String   // 관리자 ID
  actionByName String  // 관리자 이름
  reason      String?  @db.Text // 사유 (선택)

  // 기간 정보
  startDate DateTime? // 활성화 시작일
  endDate   DateTime? // 활성화 종료일

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("ad_automation_history")
}

// ============================================
// 광고자동화 결제
// ============================================

model AdAutomationPayment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 결제 정보
  paymentDate    DateTime // 결제일
  paymentAmount  Int      // 결제 금액 (원)
  paymentMethod  String   // "카드" | "계좌이체" | "현금"
  receiptUrl     String?  // 영수증 URL

  // 기간 정보
  serviceStartDate DateTime // 서비스 시작일
  serviceEndDate   DateTime // 서비스 종료일

  // 상태
  status         String   @default("completed") // "completed" | "cancelled" | "refunded"

  // 메모
  memo           String?  @db.Text

  // 관리자 정보
  registeredBy     String  // 등록한 관리자 ID
  registeredByName String  // 등록한 관리자 이름

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([paymentDate])
  @@index([status])
  @@map("ad_automation_payments")
}
